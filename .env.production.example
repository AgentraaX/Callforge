# Day 14 production env template.
#
# Copy to `.env` at the repo root on the VM (gitignored, same as dev) and
# fill in real values. Deploy with:
#   docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up -d --build
#
# Everything below that also appears in .env.example keeps the same
# meaning; only the values change for production. See docs/DEPLOYMENT.md
# for the full deploy runbook.

# LiveKit - must match the key/secret written into docker/livekit.prod.yaml
# (see docker/livekit.prod.yaml.example). LIVEKIT_URL is the public wss://
# address clients/the agent connect to - Caddy terminates TLS and proxies
# it to the livekit container (see docker/Caddyfile).
LIVEKIT_URL=wss://REPLACE_WITH_LIVEKIT_DOMAIN
LIVEKIT_API_KEY=REPLACE_WITH_REAL_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_REAL_SECRET_AT_LEAST_32_CHARS_LONG

# vLLM + Qwen2.5-7B-AWQ production endpoint (dev used Ollama on localhost -
# see agent/README/Section 7 of the backend doc for why prod should move
# off the CPU fallback if GPU is available).
LLM_BASE_URL=REPLACE_WITH_REAL_VLLM_ENDPOINT
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_API_KEY=not-needed

# Postgres - docker-compose.prod.yml reads this to set the real DB
# password (overriding the dev-only hardcoded "postgres"/"postgres" in the
# base compose file); config load fails loudly if this is left unset.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Only used if running python directly on the host outside Docker -
# under docker compose, DATABASE_URL is set explicitly by
# docker-compose.prod.yml using POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_A_STRONG_PASSWORD@localhost:5432/callforge
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Caddy reverse proxy - point both DNS records at the VM's public IP
# before first deploy (see docker/Caddyfile).
API_DOMAIN=REPLACE_WITH_YOUR_API_DOMAIN
LIVEKIT_DOMAIN=REPLACE_WITH_YOUR_LIVEKIT_DOMAIN

# Cal.com API v2 - Day 8 calendar integration
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Day 9 morning briefing - generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
BRIEFING_RECIPIENT_EMAIL=

# Day 10 CRM webhook - real CRM's incoming-webhook URL in production
CRM_WEBHOOK_URL=
