# === CallForge Configuration ===

# --- Alibaba Cloud Model Studio ---
DASHSCOPE_API_KEY=
DASHSCOPE_APP_ID=
DASHSCOPE_REGION=intl

# --- Speech-to-Text ---
# Options: vibevoice, whisper, remote, mock
STT_ENGINE=mock
WHISPER_MODEL=small
WHISPER_DEVICE=auto
VOICE_SPEECH_BASE_URL=
VOICE_AI_TOKEN=

# --- Text-to-Speech ---
# Options: cosyvoice, edge, elevenlabs, uplift, remote, mock
TTS_ENGINE=mock
ELEVENLABS_API_KEY=
FISH_API_KEY=
VOICE_CLONE_REF_DIR=voice-samples
# Edge TTS speaking rate (English fallback only; Uplift has no speed param).
TTS_SPEAKING_RATE=+6%

# --- Uplift AI (native Pakistani-Urdu TTS, ~300ms latency) ---
# Handles Urdu / code-switched-into-Urdu chunks; English chunks and any
# Uplift request failure fall through to UPLIFT_ENGLISH_ENGINE.
UPLIFT_API_KEY=
UPLIFT_OUTPUT_FORMAT=MP3_22050_128
UPLIFT_PHRASE_REPLACEMENT_CONFIG_ID=
# Options: auto (elevenlabs if keyed, else edge), elevenlabs, edge
UPLIFT_ENGLISH_ENGINE=auto

# --- LLM ---
# Any OpenAI-compatible chat/completions endpoint that supports tool calling.
# Free option: Groq (console.groq.com) -- fast inference, no credit card.
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# Or leave LLM_BASE_URL empty and set DASHSCOPE_API_KEY above instead --
# config.py auto-routes to Alibaba Cloud Model Studio's compatible-mode endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_S=12
LLM_TEMPERATURE=0.25

# --- OAuth (Google / GitHub sign-in) ---
# Get these from each provider's own developer console -- see README for
# the exact steps and the redirect URIs to register.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# This backend's own public URL -- used to build the callback redirect_uri.
# Must exactly match what's registered with each provider.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Where the browser lands after OAuth completes.
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=
REDIS_URL=

# --- Telnyx (real outbound phone calls + numbers) ---
# Get TELNYX_API_KEY from portal.telnyx.com > API Keys. TELNYX_CONNECTION_ID
# is the "Voice API App" your number is assigned to (Voice > Programmable
# Voice > Voice API Apps) -- its webhook URL doesn't need to point anywhere
# in particular since we pass a per-call webhook_url when dialing.
# TELNYX_FROM_NUMBER must be a Telnyx number you've purchased. Real phone
# calls require TTS_ENGINE=elevenlabs -- it's the only engine that emits
# Telnyx-native 8kHz mulaw/PCMU audio without a resampling step.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
# This backend's public HTTPS/WSS base URL -- Telnyx must be able to reach
# it for the status webhook and the bidirectional Media Streaming
# WebSocket. In local dev, run `ngrok http 8000` and paste the https URL
# it gives you, e.g. PUBLIC_BASE_URL=https://abcd1234.ngrok.app
PUBLIC_BASE_URL=

# --- LiveKit (browser voice call -- real WebRTC, VAD, barge-in) ---
# Create a free project at cloud.livekit.io and copy these three values
# from Settings > Keys. The agent worker connects OUT to LIVEKIT_URL --
# no inbound ports, works fine on Windows/Mac dev machines (unlike
# self-hosting livekit-server itself, which needs Linux host networking).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Internal (agent worker <-> backend, separate OS processes) ---
# Any random string -- shared secret so the LiveKit agent worker can
# reach the backend's /internal/* endpoints (persona lookup, transcript/
# state updates, lead/booking/escalation writes). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
INTERNAL_API_KEY=
# The backend's URL as seen by the agent worker -- localhost when both
# run on the same machine.
INTERNAL_BACKEND_URL=http://localhost:8000

# --- GPU-hosted models (optional) ---
# Point LLM_BASE_URL at any OpenAI-compatible endpoint your own GPU server
# exposes (vLLM, TGI, Ollama's OpenAI-compat mode, etc) -- no code change
# needed, this is the same LLM_BASE_URL used above.
#   LLM_BASE_URL=http://your-gpu-host:8000/v1
#   LLM_MODEL=your-model-name
# For a GPU-hosted STT/TTS pod, set STT_ENGINE=remote / TTS_ENGINE=remote
# and point these at it -- see stt/remote.py and tts/remote.py for the
# request/response shape they expect.
#   VOICE_SPEECH_BASE_URL=http://your-gpu-host:9000
#   VOICE_AI_TOKEN=

# --- App ---
DEBUG=false
HOLD_MS=8000
MAX_CALL_DURATION_S=600
