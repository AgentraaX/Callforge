LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretkeymustbeatleast32characterslong123

# Ollama locally (no GPU); point at a real vLLM+Qwen2.5-7B-AWQ server in prod
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callforge
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Cal.com API v2 - Day 8 calendar integration (book_meeting -> real calendar event)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Day 9 morning briefing - generic SMTP, works with any provider (Gmail,
# Outlook, a company mail server, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
BRIEFING_RECIPIENT_EMAIL=

# Day 10 CRM webhook - point at a real CRM's incoming-webhook URL in production
CRM_WEBHOOK_URL=

# Auth - JWT session tokens (email/password + OAuth both issue these)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Auth - OAuth2 (Google/Microsoft/GitHub). Each provider's /login and
# /callback return 503 until its own client id/secret are set here - real
# app credentials only, never placeholder/fake values in a committed file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Base URL this API is reachable at, used to build each provider's
# redirect_uri as {OAUTH_REDIRECT_BASE_URL}/auth/{provider}/callback -
# must exactly match what's registered in each provider's OAuth app config.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
