# === CallForge backend -- CRM additions ===
#
# This file documents only the settings the CRM dashboard adds. The full
# annotated list lives in ../../.env.example (repo root); the backend reads
# packages/backend/.env at runtime.

# --- CRM database (Postgres) ---------------------------------------------------
# Required for the CRM: contacts, companies, deals, activities, call history.
# Empty => CRM endpoints return 503 and the voice agent + live monitor run
# unchanged.
#
# Run Postgres however you like, e.g.:
#   docker run -d --name callforge-db -p 5432:5432 \
#     -e POSTGRES_USER=callforge -e POSTGRES_PASSWORD=callforge \
#     -e POSTGRES_DB=callforge postgres:16-alpine
#
DATABASE_URL=postgresql+asyncpg://callforge:callforge@localhost:5432/callforge

# Dev convenience: create any missing CRM tables from the models on startup.
# Leave true for local work; set false in production and run migrations:
#   cd packages/backend && alembic upgrade head
CRM_AUTO_CREATE_TABLES=true
